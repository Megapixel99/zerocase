{
  "name": "zerocase",
  "version": "0.1.4",
  "description": "A check with a zero denominator reports clean. Read the junit/TAP/lcov/eslint report the runner already wrote and put a floor under what actually ran.",
  "type": "module",
  "exports": {
    ".": "./js/src/index.js",
    "./reports": "./js/src/reports.js",
    "./parse": "./js/src/parse.js"
  },
  "bin": {
    "zerocase": "js/bin/zerocase.js"
  },
  "files": [
    "js/src",
    "js/bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test js/test/*.test.js"
  },
  "dependencies": {
    "@megapixel99/didrun": ">=0.1.0"
  },
  "keywords": [
    "ci",
    "junit",
    "tap",
    "lcov",
    "cobertura",
    "eslint",
    "coverage",
    "test-count",
    "zero-tests",
    "empty-glob",
    "denominator",
    "evidence",
    "guard",
    "verification",
    "false-positive",
    "silent-failure"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Megapixel99/zerocase.git"
  },
  "bugs": {
    "url": "https://github.com/Megapixel99/zerocase/issues"
  },
  "homepage": "https://github.com/Megapixel99/zerocase#readme"
}
